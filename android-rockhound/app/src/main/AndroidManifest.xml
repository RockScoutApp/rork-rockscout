<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Required on Android 6–9 (API 24–28) for saving images to the device
         gallery via MediaStore. Android 10+ uses scoped storage and does not
         need this permission. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- Allows the app to install a downloaded update APK over the existing
         install (no uninstall needed). Required for in-app self-update. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- APK files downloaded for in-app self-update live in cache and are
         shared to the system installer via FileProvider. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
    </queries>

    <application
        android:name=".RockScoutApplication"
        android:largeHeap="true"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="RockScout"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.RorkApp">
        <receiver
            android:name="androidx.work.impl.background.systemalarm.RescheduleReceiver"
            android:exported="false" />

        <!-- Receives the outcome of in-app update installs (PackageInstaller
             sessions) so real failure reasons can be shown to the user. -->
        <receiver
            android:name=".data.InstallResultReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.rork.rockscout.action.INSTALL_RESULT" />
            </intent-filter>
        </receiver>

        <!-- Google AdMob — production app ID for RockScout. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-4371366555693080~9235421799" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:supportsPictureInPicture="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden|uiMode"
            android:theme="@style/Theme.RorkApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Share-to-app: lets users share images from email, Facebook,
                 Messages, Photos, etc. directly into Saved Images. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="rockscout" android:host="location" />
                <data android:scheme="rockscout" android:host="locations" />
                <data android:scheme="rockscout" android:host="specimen" />
                <data android:scheme="rockscout" android:host="period" />
                <data android:scheme="rockscout" android:host="friends" />
                <data android:scheme="rockscout" android:host="messenger" />
                <data android:scheme="rockscout" android:host="message_requests" />
                <data android:scheme="rockscout" android:host="trade_board" />
                <data android:scheme="rockscout" android:host="my_trades" />
                <data android:scheme="rockscout" android:host="scan" />
                <data android:scheme="rockscout" android:host="sign_in" />
                <data android:scheme="rockscout" android:host="home" />
                <data android:scheme="rockscout" android:host="profile" />
                <data android:scheme="rockscout" android:host="contact_us" />
                <data android:scheme="rockscout" android:host="notifications" />
                <data android:scheme="rockscout" android:host="user_profile" />
                <data android:scheme="rockscout" android:host="group_chat" />
                <data android:scheme="rockscout" android:host="spot" />
                <data android:scheme="rockscout" android:host="ping" />
                <data android:scheme="rockscout" android:host="verify_email" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>

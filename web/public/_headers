# Explicit cache-control for Cloudflare Pages (deploy kick 2026-07-21 cycle 3).
# HTML is always revalidated so new deploys are visible instantly.
/*
  cache-control: public, max-age=0, must-revalidate

/index.html
  cache-control: public, max-age=0, must-revalidate

# Hashed bundles: filenames change every build, so cache aggressively.
/assets/*
  cache-control: public, max-age=31536000, immutable

# Site images: 1 day.
/images/*
  cache-control: public, max-age=86400

# Tutorial video: immutable, served with the Matroska content type so mobile
# players stream it instead of downloading it as a generic binary.
/tutorial/*
  cache-control: public, max-age=31536000, immutable
  content-type: video/x-matroska
  accept-ranges: bytes
